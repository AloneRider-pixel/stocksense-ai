APP_NAME=StockSense AI
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://stocksense:stocksense@localhost:5432/stocksense
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# Authentication
JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30

# Service-to-service integration
API_KEY=

# Abuse protection
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Browser/security configuration
CORS_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=*

# Market data
MARKET_DATA_PROVIDER=twelve_data
TWELVE_DATA_API_KEY=your-twelve-data-api-key
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
MARKET_DATA_MAX_ROWS=5000
MARKET_DATA_TIMEOUT_SECONDS=10
MARKET_DATA_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,NVDA
MARKET_DATA_REFRESH_HOUR=22
MARKET_DATA_REFRESH_MINUTE=30
