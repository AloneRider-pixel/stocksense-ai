# DEVELOPMENT ONLY. Never deploy this file or its sample values to production.
APP_NAME=StockSense AI
ENVIRONMENT=development

# Direct local Python execution uses the localhost default from app/core/config.py.
# Docker Compose supplies its internal postgres URL when DATABASE_URL is unset.
# Production must set DATABASE_URL explicitly to a valid PostgreSQL URL with strong credentials.
# DATABASE_URL=postgresql+psycopg://<user>:<url-encoded-password>@<host>:5432/<database>
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# Authentication: development placeholder only; production must use a secret manager.
JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30

# Abuse protection
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Browser/security configuration: local-only values; use explicit production HTTPS origins and hostnames.
CORS_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=*

# Local Docker Compose PostgreSQL password only.
POSTGRES_PASSWORD=stocksense

# Market data
MARKET_DATA_PROVIDER=twelve_data
TWELVE_DATA_API_KEY=your-twelve-data-api-key
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
MARKET_DATA_MAX_ROWS=5000
MARKET_DATA_TIMEOUT_SECONDS=10
MARKET_DATA_REFRESH_INTERVAL_MINUTES=30
MARKET_DATA_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,NVDA
MARKET_DATA_REFRESH_HOUR=22
MARKET_DATA_REFRESH_MINUTE=30
